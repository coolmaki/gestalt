{
  "Passport": {
    "Application": {
      "BaseUrl": "https://localhost:5001",
      "AccessToken": {
        "LifetimeMinutes": 15,
        "Issuer": "https://localhost:5001",
        "Audience": "supercluster"
      },
      "RefreshToken": {
        "LifetimeDays": 30,
        "RotationEnabled": true
      },
      "SigningKey": {
        "Algorithm": "ES256",
        "KeyPath": "signing-key.pem"
      }
    },
    "Infrastructure": {
      "Persistence": {
        "Provider": "Sqlite",
        "ConnectionString": "Data Source=passport.db"
      }
    }
  }
}